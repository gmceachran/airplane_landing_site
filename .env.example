# Copy to .env.local and fill in
# Rails API origin (defaults to localhost:3000 for development)
VITE_API_BASE_URL=http://localhost:3000

# Hero image override (optional)
# VITE_HERO_IMAGE_URL=https://...

# Contact email override (optional)
# VITE_CONTACT_EMAIL=you@example.com

# Lead form endpoint — if blank, the form shows a mailto: link
# VITE_LEAD_FORM_ENDPOINT=https://...
